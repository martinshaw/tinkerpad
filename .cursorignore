screenshots/
**/*.png
**/*.jpg
**/*.jpeg
**/*.ico
**/*.icns
**/*.tiff

# Logs, OS, local IDE
**/*.log
**/.DS_Store
.idea/
.vscode/
*.swp

# Embedded sandbox vendor if present
resources/sandbox/vendor/
